        local nl=Instance.new("TextLabel",np); nl.Size=UDim2.fromScale(1,1); nl.BackgroundTransparency=1
        nl.Text="ℹ  "..note; nl.TextColor3=T.TextDim; nl.Font=Enum.Font.Gotham; nl.TextSize=11; nl.ZIndex=703
    end
    local ibg=Instance.new("Frame",w); ibg.Size=UDim2.new(1,-30,0,40); ibg.Position=UDim2.fromOffset(15,98)
    ibg.BackgroundColor3=T.Surface; ibg.BorderSizePixel=0; ibg.ZIndex=702
    Instance.new("UICorner",ibg).CornerRadius=UDim.new(0,8)
    local ibs=Instance.new("UIStroke",ibg); ibs.Color=T.Border; ibs.Thickness=1
    local kb=Instance.new("TextBox",ibg); kb.Size=UDim2.new(1,-18,1,0); kb.Position=UDim2.fromOffset(9,0)
    kb.BackgroundTransparency=1; kb.Text=""; kb.PlaceholderText="Введи ключ..."
    kb.PlaceholderColor3=T.TextDim; kb.TextColor3=T.Text; kb.Font=Enum.Font.Gotham; kb.TextSize=13
    kb.ClearTextOnFocus=false; kb.ZIndex=703
    local sl=KL("",11,Color3.fromRGB(255,80,80),false,146)
    local sb2=Instance.new("TextButton",w); sb2.Size=UDim2.new(1,-30,0,40); sb2.Position=UDim2.fromOffset(15,164)
    sb2.BackgroundColor3=T.Accent; sb2.BorderSizePixel=0; sb2.Text="Подтвердить"
    sb2.TextColor3=Color3.new(1,1,1); sb2.Font=Enum.Font.GothamBold; sb2.TextSize=14; sb2.ZIndex=702
    Instance.new("UICorner",sb2).CornerRadius=UDim.new(0,8)
    MkDrag(w,w); w.BackgroundTransparency=1; w.Position=UDim2.new(0.5,0,0.4,0)
    TW(w,0.4,{Position=UDim2.fromScale(0.5,0.5),BackgroundTransparency=0},Enum.EasingStyle.Back)
    local function shake()
        local offs={10,-10,7,-7,4,-4,1,-1,0}
        for _,dx in ipairs(offs) do TW(w,0.04,{Position=UDim2.new(0.5,dx,0.5,0)}); task.wait(0.045) end
    end
    local function check()
        local ent=kb.Text:gsub("%s","")
        for _,k in ipairs(Keys) do
            if ent==k then
                if Save then FW(File..".txt",ent) end
                sl.Text="✓ Принято!"; sl.TextColor3=T.Accent
                TW(w,0.3,{Position=UDim2.new(0.5,0,0.62,0),BackgroundTransparency=1})
                task.wait(0.35); ov:Destroy(); passed=true; return
            end
        end
        ibs.Color=Color3.fromRGB(255,60,60); sl.Text="✗ Неверный ключ."
        task.spawn(shake); task.delay(1.2,function() ibs.Color=T.Border end)
    end
    sb2.MouseButton1Click:Connect(check)
    kb.FocusLost:Connect(function(e) if e then check() end end)
    sb2.MouseEnter:Connect(function() TW(sb2,0.15,{BackgroundColor3=T.AccentDim}) end)
    sb2.MouseLeave:Connect(function() TW(sb2,0.15,{BackgroundColor3=T.Accent}) end)
    repeat task.wait() until passed or not ov.Parent
end

