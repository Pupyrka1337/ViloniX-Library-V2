-- ViloniX Library v2.5 (UPGRADED)

local ViloniX = {}
ViloniX.__index = ViloniX

-- FLAGS + CONFIG
ViloniX.Flags = {}
ViloniX.Config = {
    Enabled = false,
    Folder = "ViloniXConfigs",
    File = "default"
}

local HttpService = game:GetService("HttpService")

-- CONFIG SYSTEM
function ViloniX:SetConfig(cfg)
    self.Config = cfg
end

function ViloniX:SaveConfig()
    if not self.Config.Enabled then return end
    
    if makefolder and not isfolder(self.Config.Folder) then
        makefolder(self.Config.Folder)
    end
    
    writefile(
        self.Config.Folder.."/"..self.Config.File..".json",
        HttpService:JSONEncode(self.Flags)
    )
end

function ViloniX:LoadConfig()
    if not self.Config.Enabled then return end
    
    local path = self.Config.Folder.."/"..self.Config.File..".json"
    
    if isfile and isfile(path) then
        local data = HttpService:JSONDecode(readfile(path))
        for k,v in pairs(data) do
            self.Flags[k] = v
        end
    end
end

-- KEY SYSTEM (МОЖНО ВЫКЛЮЧИТЬ)
function ViloniX:KeySystem(cfg)
    if cfg and cfg.Enabled == false then return true end
    
    local Keys = cfg.Keys or {"FREE123"}
    
    local input = Keys[1] -- упрощённо
    
    if table.find(Keys, input) then
        return true
    end
end

-- WINDOW
function ViloniX:CreateWindow(cfg)
    local Window = {}
    
    function Window:CreateTab()
        local Tab = {}
        
        -- SLIDER
        function Tab:CreateSlider(cfg)
            local flag = cfg.Flag or cfg.Name
            local Value = cfg.CurrentValue or 0
            local Min = cfg.Range[1]
            local Max = cfg.Range[2]
            
            if ViloniX.Flags[flag] then
                Value = ViloniX.Flags[flag]
            end
            
            ViloniX.Flags[flag] = Value
            
            local function set(v)
                v = math.clamp(v, Min, Max)
                Value = v
                ViloniX.Flags[flag] = v
                cfg.Callback(v)
                ViloniX:SaveConfig()
            end
            
            return {
                Set = function(self,v) set(v) end
            }
        end
        
        -- TOGGLE
        function Tab:CreateToggle(cfg)
            local flag = cfg.Flag or cfg.Name
            local Value = cfg.CurrentValue or false
            
            if ViloniX.Flags[flag] ~= nil then
                Value = ViloniX.Flags[flag]
            end
            
            ViloniX.Flags[flag] = Value
            
            return {
                Set = function(self,v)
                    Value = v
                    ViloniX.Flags[flag] = v
                    cfg.Callback(v)
                    ViloniX:SaveConfig()
                end
            }
        end
        
        -- DROPDOWN
        function Tab:CreateDropdown(cfg)
            local flag = cfg.Flag or cfg.Name
            local Value = cfg.CurrentOption[1]
            
            if ViloniX.Flags[flag] then
                Value = ViloniX.Flags[flag]
            end
            
            ViloniX.Flags[flag] = Value
            
            return {
                Set = function(self,v)
                    ViloniX.Flags[flag] = v
                    cfg.Callback(v)
                    ViloniX:SaveConfig()
                end
            }
        end
        
        -- BUTTON
        function Tab:CreateButton(cfg)
            return {
                Fire = function()
                    cfg.Callback()
                end
            }
        end
        
        return Tab
    end
    
    function Window:Notify(cfg)
        print(cfg.Title..": "..cfg.Content)
    end
    
    return Window
end

return ViloniX
