        bar.Size = UDim2.fromOffset(3, 36)
        bar.Position = UDim2.fromOffset(0, 12)
        bar.BackgroundColor3 = Theme.Accent
        bar.BorderSizePixel = 0
        bar.ZIndex = 201
        bar.Parent = notif

        local tLbl = Instance.new("TextLabel")
        tLbl.Size = UDim2.new(1, -20, 0, 20)
        tLbl.Position = UDim2.fromOffset(14, 8)
        tLbl.BackgroundTransparency = 1
        tLbl.Text = Title
        tLbl.TextColor3 = Theme.Accent
        tLbl.Font = Enum.Font.GothamBold
        tLbl.TextSize = 13
        tLbl.TextXAlignment = Enum.TextXAlignment.Left
        tLbl.ZIndex = 201
        tLbl.Parent = notif

        local cLbl = Instance.new("TextLabel")
        cLbl.Size = UDim2.new(1, -20, 0, 16)
        cLbl.Position = UDim2.fromOffset(14, 30)
        cLbl.BackgroundTransparency = 1
        cLbl.Text = Content
        cLbl.TextColor3 = Theme.TextDim
        cLbl.Font = Enum.Font.Gotham
        cLbl.TextSize = 11
        cLbl.TextXAlignment = Enum.TextXAlignment.Left
        cLbl.ZIndex = 201
        cLbl.Parent = notif

        -- Slide in
        QuickTween(notif, 0.3, {Position = UDim2.new(1, -16, 1, -16)})
        task.delay(Duration, function()
            QuickTween(notif, 0.3, {Position = UDim2.new(1, -16, 1, 80)})
            task.wait(0.35)
            notif:Destroy()
        end)
    end

    return Window
end

return ViloniX
