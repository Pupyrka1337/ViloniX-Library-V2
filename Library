function ViloniX:KeySystem(cfg)
    cfg=cfg or {}
    if cfg.Enabled==false then return end
    local Keys=cfg.Keys or {}; local File=cfg.FileName or "ViloniXKey"
    local Save=cfg.SaveKey~=false; local T=Themes[cfg.Theme or "Default"] or Themes.Default
    if Save then
        local s=FR(File..".txt")
        if s then for _,k in ipairs(Keys) do if s:gsub("%s","")== k then return end end end
    end
    local passed=false
    local ov=Instance.new("Frame",ScreenGui)
    ov.Size=UDim2.fromScale(1,1); ov.BackgroundColor3=Color3.new(0,0,0)
    ov.BackgroundTransparency=0.4; ov.BorderSizePixel=0; ov.ZIndex=700
    local w=Instance.new("Frame",ov)
    w.AnchorPoint=Vector2.new(0.5,0.5); w.Position=UDim2.fromScale(0.5,0.5)
    w.Size=UDim2.fromOffset(420,232); w.BackgroundColor3=T.KeyBg; w.BorderSizePixel=0; w.ZIndex=701
    Instance.new("UICorner",w).CornerRadius=UDim.new(0,12)
    local ws=Instance.new("UIStroke",w); ws.Color=T.Accent; ws.Thickness=1; ws.Transparency=0.5
    local strip=Instance.new("Frame",w)
    strip.Size=UDim2.new(1,0,0,3); strip.BackgroundColor3=T.Accent; strip.BorderSizePixel=0; strip.ZIndex=702
    Instance.new("UICorner",strip).CornerRadius=UDim.new(0,12)
    local function KL(txt,sz,clr,bold,y)
        local l=Instance.new("TextLabel",w); l.Size=UDim2.new(1,-30,0,sz+6); l.Position=UDim2.fromOffset(15,y)
        l.BackgroundTransparency=1; l.Text=txt; l.TextColor3=clr
        l.Font=bold and Enum.Font.GothamBold or Enum.Font.Gotham
        l.TextSize=sz; l.TextXAlignment=Enum.TextXAlignment.Left; l.ZIndex=702; return l
    end
    KL(cfg.Title or "ViloniX",20,T.Accent,true,14)
    KL(cfg.SubTitle or "Требуется ключ",13,T.TextDim,false,40)
    local note=cfg.Note or ""; if note~="" then
        local np=Instance.new("Frame",w); np.Size=UDim2.new(1,-30,0,22); np.Position=UDim2.fromOffset(15,66)
        np.BackgroundColor3=T.Surface; np.BorderSizePixel=0; np.ZIndex=702
