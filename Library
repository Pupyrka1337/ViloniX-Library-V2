        -- ─────────────────────────────────────────────────────
        function Tab:CreateDropdown(cfg)
            cfg = cfg or {}
            local Name     = cfg.Name or "Dropdown"
            local Options  = cfg.Options or {}
            local Current  = (cfg.CurrentOption and cfg.CurrentOption[1]) or (Options[1] or "None")
            local Multi    = cfg.MultipleOptions or false
            local Callback = cfg.Callback or function() end

            local el = MakeElement(42)
            local open = false
            local selected = Multi and {} or Current

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(1, -60, 1, 0)
