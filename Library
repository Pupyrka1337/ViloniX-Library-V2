        -- ════════════════════════════════════════════
        -- DROPDOWN
        -- ════════════════════════════════════════════
        function Tab:CreateDropdown(cfg2)
            cfg2 = cfg2 or {}
            local Name     = cfg2.Name or "Dropdown"
            local Options  = cfg2.Options or {}
            local Multi    = cfg2.MultipleOptions or false
            local Callback = cfg2.Callback or function() end
            local id       = cfg2.Id or (Name..math.random(1,99999))

            local Current  = (cfg2.CurrentOption and cfg2.CurrentOption[1]) or (Options[1] or "None")
            local selected = Multi and {} or Current

            local el = NewElem(40)
            local open = false
            local OPT_H = 30

            local nl = Instance.new("TextLabel")
            nl.Size = UDim2.new(1,-56,1,0); nl.Position = UDim2.fromOffset(12,0)
            nl.BackgroundTransparency = 1; nl.Text = Name
            nl.TextColor3 = T.TextAccent; nl.Font = Enum.Font.GothamBold; nl.TextSize = 13
            nl.TextXAlignment = Enum.TextXAlignment.Left; nl.ZIndex = el.ZIndex+1; nl.Parent = el

            -- Current value display
            local curLbl = Instance.new("TextLabel")
            curLbl.Size = UDim2.fromOffset(80,20); curLbl.AnchorPoint = Vector2.new(1,0.5)
            curLbl.Position = UDim2.new(1,-40,0.5,0)
            curLbl.BackgroundTransparency = 1; curLbl.Text = Current
            curLbl.TextColor3 = T.TextDim; curLbl.Font = Enum.Font.Gotham; curLbl.TextSize = 11
            curLbl.TextXAlignment = Enum.TextXAlignment.Right; curLbl.ZIndex = el.ZIndex+1; curLbl.Parent = el

            local arrow = Instance.new("TextLabel")
            arrow.Size = UDim2.fromOffset(24,24); arrow.AnchorPoint = Vector2.new(1,0.5)
            arrow.Position = UDim2.new(1,-10,0.5,0)
            arrow.BackgroundTransparency = 1; arrow.Text = "▼"
            arrow.TextColor3 = T.Accent; arrow.Font = Enum.Font.GothamBold; arrow.TextSize = 11
            arrow.ZIndex = el.ZIndex+1; arrow.Parent = el

            -- Drop frame (overlays below element)
            local dropFrame = Instance.new("ScrollingFrame")
            dropFrame.Size = UDim2.new(1,0,0,0); dropFrame.Position = UDim2.new(0,0,1,4)
            dropFrame.BackgroundColor3 = T.Surface; dropFrame.BorderSizePixel = 0
            dropFrame.ClipsDescendants = true; dropFrame.ZIndex = 20
            dropFrame.ScrollBarThickness = 2; dropFrame.ScrollBarImageColor3 = T.Accent
            dropFrame.Visible = false; dropFrame.CanvasSize = UDim2.fromOffset(0,0)
            dropFrame.Parent = el

            local dfc = Instance.new("UICorner"); dfc.CornerRadius = UDim.new(0,8); dfc.Parent = dropFrame
            local dfs = Instance.new("UIStroke"); dfs.Color = T.Border; dfs.Thickness = 1; dfs.Parent = dropFrame
            local dfl = Instance.new("UIListLayout"); dfl.SortOrder = Enum.SortOrder.LayoutOrder; dfl.Parent = dropFrame

            local totalH = 0
            local optBtns = {}

            local function rebuildOptions()
                for _, c in ipairs(dropFrame:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                optBtns = {}
                totalH = 0

                for i, opt in ipairs(Options) do
                    local isSelected = (not Multi and opt == Current) or (Multi and selected[opt])
                    local ob = Instance.new("TextButton")
                    ob.Size = UDim2.new(1,0,0,OPT_H); ob.LayoutOrder = i
                    ob.BackgroundColor3 = T.Surface; ob.BackgroundTransparency = isSelected and 0.5 or 1
                    ob.Text = "  " .. opt
                    ob.TextColor3 = isSelected and T.Accent or T.Text
                    ob.Font = isSelected and Enum.Font.GothamBold or Enum.Font.Gotham
                    ob.TextSize = 12; ob.TextXAlignment = Enum.TextXAlignment.Left
                    ob.ZIndex = 21; ob.Parent = dropFrame

                    ob.MouseEnter:Connect(function()
                        if not ((not Multi and opt == Current) or (Multi and selected[opt])) then
                            QT(ob, 0.1, {BackgroundTransparency = 0.8})
                        end
                    end)
                    ob.MouseLeave:Connect(function()
                        if not ((not Multi and opt == Current) or (Multi and selected[opt])) then
                            QT(ob, 0.1, {BackgroundTransparency = 1})
                        end
                    end)

                    ob.MouseButton1Click:Connect(function()
                        if not Multi then
                            Current = opt
                            curLbl.Text = opt
                            for _, o2 in ipairs(optBtns) do
                                o2.TextColor3 = T.Text
                                o2.Font = Enum.Font.Gotham
                                o2.BackgroundTransparency = 1
                            end
                            ob.TextColor3 = T.Accent; ob.Font = Enum.Font.GothamBold
                            ob.BackgroundTransparency = 0.5
                            open = false
                            QT(dropFrame, 0.2, {Size = UDim2.new(1,0,0,0)})
                            QT(arrow, 0.2, {Rotation = 0})
                            task.delay(0.22, function() dropFrame.Visible = false end)
                            pcall(Callback, opt)
                        else
                            selected[opt] = not selected[opt]
                            ob.TextColor3 = selected[opt] and T.Accent or T.Text
                            ob.Font = selected[opt] and Enum.Font.GothamBold or Enum.Font.Gotham
                            ob.BackgroundTransparency = selected[opt] and 0.5 or 1
                            local list = {}
                            for k in pairs(selected) do table.insert(list, k) end
                            curLbl.Text = #list > 0 and table.concat(list,", ") or "None"
                            pcall(Callback, list)
                        end
                    end)

                    optBtns[i] = ob
                    totalH = totalH + OPT_H
                end
                local maxH = math.min(totalH, 120)
                dropFrame.CanvasSize = UDim2.fromOffset(0, totalH)
            end

            rebuildOptions()

            el.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    open = not open
                    if open then
                        dropFrame.Visible = true
                        dropFrame.Size = UDim2.new(1,0,0,0)
                        QT(dropFrame, 0.25, {Size = UDim2.new(1,0,0,math.min(totalH,120))})
                        QT(arrow, 0.2, {Rotation = 180})
                    else
                        QT(dropFrame, 0.2, {Size = UDim2.new(1,0,0,0)})
                        QT(arrow, 0.2, {Rotation = 0})
                        task.delay(0.22, function() dropFrame.Visible = false end)
                    end
                end
            end)

            RegisterThemeListener(function(newT)
                QT(nl,       0.2, {TextColor3 = newT.TextAccent})
                QT(curLbl,   0.2, {TextColor3 = newT.TextDim})
                QT(arrow,    0.2, {TextColor3 = newT.Accent})
                QT(dropFrame,0.2, {BackgroundColor3 = newT.Surface})
                QT(dfs,      0.2, {Color = newT.Border})
                for _, ob in ipairs(optBtns) do
                    QT(ob, 0.2, {TextColor3 = newT.Text})
                end
            end)

            local obj = {
                Set = function(_, v)
                    Current = v; curLbl.Text = v
                    rebuildOptions()
                end,
                Refresh = function(_, newOpts)
                    Options = newOpts; rebuildOptions()
                end,
                Get = function() return Current end,
            }
            Reg(id, obj.Get, function(v) obj:Set(v) end)
            return obj
        end

