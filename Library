local NotifQueue    = {}
local NotifRunning  = false
local NOTIF_MARGIN  = 10
local NOTIF_HEIGHT  = 66

local function ProcessNotifQueue()
    if NotifRunning then return end
    NotifRunning = true
    task.spawn(function()
        while #NotifQueue > 0 do
            local cfg = table.remove(NotifQueue, 1)
            local T       = cfg.Theme
            local Title   = cfg.Title   or "Notice"
            local Content = cfg.Content or ""
            local Dur     = cfg.Duration or 3
            local Icon    = cfg.Icon    or "ℹ"

            local notif = Instance.new("Frame")
            notif.Size              = UDim2.fromOffset(280, NOTIF_HEIGHT)
            notif.AnchorPoint       = Vector2.new(1, 1)
            notif.Position          = UDim2.new(1, -16, 1, 60)
            notif.BackgroundColor3  = T.NotifBg
            notif.BorderSizePixel   = 0
            notif.ZIndex            = 500
            notif.Parent            = ScreenGui

            local nc = Instance.new("UICorner")
            nc.CornerRadius = UDim.new(0, 9)
            nc.Parent = notif

            local ns = Instance.new("UIStroke")
            ns.Color       = T.Accent
            ns.Thickness   = 1
            ns.Transparency= 0.45
            ns.Parent      = notif

            -- Left accent bar
            local bar = Instance.new("Frame")
            bar.Size             = UDim2.fromOffset(3, 38)
            bar.Position         = UDim2.fromOffset(0, 14)
            bar.BackgroundColor3 = T.Accent
            bar.BorderSizePixel  = 0
            bar.ZIndex           = 501
            bar.Parent           = notif

            -- Progress bar (bottom)
            local progBg = Instance.new("Frame")
            progBg.Size            = UDim2.new(1, -8, 0, 2)
            progBg.Position        = UDim2.new(0, 4, 1, -4)
            progBg.BackgroundColor3= T.Border
            progBg.BorderSizePixel = 0
            progBg.ZIndex          = 502
            progBg.Parent          = notif
            local progFill = Instance.new("Frame")
            progFill.Size            = UDim2.fromScale(1, 1)
            progFill.BackgroundColor3= T.Accent
            progFill.BorderSizePixel = 0
            progFill.ZIndex          = 503
            progFill.Parent          = progBg

            -- Icon
            local iconLbl = Instance.new("TextLabel")
            iconLbl.Size               = UDim2.fromOffset(22, NOTIF_HEIGHT)
            iconLbl.Position           = UDim2.fromOffset(12, 0)
            iconLbl.BackgroundTransparency = 1
            iconLbl.Text               = Icon
            iconLbl.TextColor3         = T.Accent
            iconLbl.Font               = Enum.Font.GothamBold
            iconLbl.TextSize           = 16
            iconLbl.ZIndex             = 501
            iconLbl.Parent             = notif

            local tLbl = Instance.new("TextLabel")
            tLbl.Size               = UDim2.new(1, -48, 0, 20)
            tLbl.Position           = UDim2.fromOffset(40, 10)
            tLbl.BackgroundTransparency = 1
            tLbl.Text               = Title
            tLbl.TextColor3         = T.Text
            tLbl.Font               = Enum.Font.GothamBold
            tLbl.TextSize           = 13
            tLbl.TextXAlignment     = Enum.TextXAlignment.Left
            tLbl.ZIndex             = 501
            tLbl.Parent             = notif

            local cLbl = Instance.new("TextLabel")
            cLbl.Size               = UDim2.new(1, -48, 0, 28)
            cLbl.Position           = UDim2.fromOffset(40, 30)
            cLbl.BackgroundTransparency = 1
            cLbl.Text               = Content
            cLbl.TextColor3         = T.TextDim
            cLbl.Font               = Enum.Font.Gotham
            cLbl.TextSize           = 11
            cLbl.TextXAlignment     = Enum.TextXAlignment.Left
            cLbl.TextWrapped        = true
            cLbl.ZIndex             = 501
            cLbl.Parent             = notif

            -- Slide in
            QT(notif, 0.3, {Position = UDim2.new(1,-16,1,-(NOTIF_MARGIN+NOTIF_HEIGHT))})
            -- Shrink progress bar
            Tween(progFill, TweenInfo.new(Dur, Enum.EasingStyle.Linear), {Size = UDim2.fromScale(0,1)})
            task.wait(Dur)
            -- Slide out
            QT(notif, 0.3, {Position = UDim2.new(1,-16,1,80)})
            task.wait(0.35)
            notif:Destroy()
        end
        NotifRunning = false
    end)
end

