    ibStroke.Thickness = 1
    ibStroke.Parent = inputBg

    local keyInput = Instance.new("TextBox")
    keyInput.Size = UDim2.new(1, -20, 1, 0)
    keyInput.Position = UDim2.fromOffset(10, 0)
    keyInput.BackgroundTransparency = 1
    keyInput.Text = ""
    keyInput.PlaceholderText = "Enter key here..."
    keyInput.PlaceholderColor3 = Theme.TextDim
    keyInput.TextColor3 = Theme.Text
    keyInput.Font = Enum.Font.Gotham
    keyInput.TextSize = 14
    keyInput.ZIndex = 103
    keyInput.ClearTextOnFocus = false
    keyInput.Parent = inputBg

    -- Status label
    local statusLbl = Instance.new("TextLabel")
    statusLbl.Size = UDim2.new(1, -40, 0, 16)
    statusLbl.Position = UDim2.fromOffset(20, 148)
    statusLbl.BackgroundTransparency = 1
    statusLbl.Text = ""
    statusLbl.TextColor3 = Color3.fromRGB(255, 80, 80)
    statusLbl.Font = Enum.Font.Gotham
    statusLbl.TextSize = 11
    statusLbl.ZIndex = 102
    statusLbl.Parent = window

    -- Submit button
    local submitBtn = Instance.new("TextButton")
    submitBtn.Size = UDim2.new(1, -40, 0, 38)
    submitBtn.Position = UDim2.fromOffset(20, 166)
    submitBtn.BackgroundColor3 = Theme.Accent
    submitBtn.BorderSizePixel = 0
    submitBtn.Text = "Submit Key"
    submitBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    submitBtn.Font = Enum.Font.GothamBold
    submitBtn.TextSize = 14
    submitBtn.ZIndex = 102
    submitBtn.Parent = window
    local sbCorner = Instance.new("UICorner")
    sbCorner.CornerRadius = UDim.new(0, 8)
    sbCorner.Parent = submitBtn

    MakeDraggable(window, window)

    -- Animate in
    window.Position = UDim2.new(0.5, 0, 0.4, 0)
    window.BackgroundTransparency = 1
    QuickTween(window, 0.35, {Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 0})

    local function checkKey()
        local entered = keyInput.Text
        for _, k in ipairs(Keys) do
            if entered == k then
                if SaveKey then SaveFile(FileName, entered) end
                statusLbl.Text = "✓ Key accepted!"
                statusLbl.TextColor3 = Theme.Accent
                QuickTween(window, 0.3, {Position = UDim2.new(0.5, 0, 0.6, 0), BackgroundTransparency = 1})
                task.wait(0.35)
                overlay:Destroy()
                passed = true
                return
            end
        end
        ibStroke.Color = Color3.fromRGB(255, 60, 60)
        statusLbl.Text = "✗ Invalid key. Try again."
        QuickTween(window, 0.05, {Position = UDim2.new(0.5, 6, 0.5, 0)})
        task.wait(0.05)
        QuickTween(window, 0.05, {Position = UDim2.new(0.5, -6, 0.5, 0)})
        task.wait(0.05)
        QuickTween(window, 0.05, {Position = UDim2.fromScale(0.5, 0.5)})
        task.wait(0.3)
        ibStroke.Color = Theme.Border
    end

    submitBtn.MouseButton1Click:Connect(checkKey)
    keyInput.FocusLost:Connect(function(enter) if enter then checkKey() end end)

    submitBtn.MouseEnter:Connect(function()
        QuickTween(submitBtn, 0.15, {BackgroundColor3 = Theme.AccentGlow})
    end)
    submitBtn.MouseLeave:Connect(function()
        QuickTween(submitBtn, 0.15, {BackgroundColor3 = Theme.Accent})
    end)

    -- Wait for pass
    repeat task.wait() until passed or not overlay.Parent
end

