        -- ════════════════════════════════════════════
        function Tab:CreateSlider(cfg2)
            cfg2 = cfg2 or {}
            local Name    = cfg2.Name    or "Slider"
            local Min     = (cfg2.Range and cfg2.Range[1]) or 0
            local Max     = (cfg2.Range and cfg2.Range[2]) or 100
            local Inc     = cfg2.Increment or 1
            local Suffix  = cfg2.Suffix or ""
            local Value   = cfg2.CurrentValue or Min
            local Callback= cfg2.Callback or function() end
            local id      = cfg2.Id or (Name..math.random(1,99999))

            local el = NewElem(58)

            local nl = Instance.new("TextLabel")
            nl.Size = UDim2.new(1,-70,0,20); nl.Position = UDim2.fromOffset(12,8)
            nl.BackgroundTransparency = 1; nl.Text = Name
            nl.TextColor3 = T.TextAccent; nl.Font = Enum.Font.GothamBold; nl.TextSize = 13
            nl.TextXAlignment = Enum.TextXAlignment.Left; nl.ZIndex = el.ZIndex+1; nl.Parent = el

            local vl = Instance.new("TextLabel")
            vl.Size = UDim2.fromOffset(60,20); vl.Position = UDim2.new(1,-70,0,8)
            vl.BackgroundTransparency = 1; vl.Text = tostring(Value)..Suffix
            vl.TextColor3 = T.TextDim; vl.Font = Enum.Font.Gotham; vl.TextSize = 12
            vl.TextXAlignment = Enum.TextXAlignment.Right; vl.ZIndex = el.ZIndex+1; vl.Parent = el

            local track = Instance.new("Frame")
            track.Size = UDim2.new(1,-24,0,8); track.Position = UDim2.fromOffset(12,34)
            track.BackgroundColor3 = T.ToggleOff; track.BorderSizePixel = 0; track.ZIndex = el.ZIndex+1; track.Parent = el
            local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(1,0); tc.Parent = track

            local fill = Instance.new("Frame")
            fill.Size = UDim2.fromScale((Value-Min)/(Max-Min),1)
            fill.BackgroundColor3 = T.SliderFill; fill.BorderSizePixel = 0; fill.ZIndex = el.ZIndex+2; fill.Parent = track
            local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(1,0); fc.Parent = fill

            local knob = Instance.new("Frame")
            knob.Size = UDim2.fromOffset(18,18); knob.AnchorPoint = Vector2.new(0.5,0.5)
            knob.Position = UDim2.new((Value-Min)/(Max-Min),0,0.5,0)
            knob.BackgroundColor3 = Color3.fromRGB(255,255,255); knob.BorderSizePixel = 0
            knob.ZIndex = el.ZIndex+3; knob.Parent = track
            local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1,0); kc.Parent = knob
            local ks = Instance.new("UIStroke"); ks.Color = T.Accent; ks.Thickness = 2; ks.Transparency = 0.3; ks.Parent = knob

            local draggingS = false

            local function updSlider(input)
                local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                local raw = Min + (Max-Min)*rel
                local snapped = math.clamp(math.round(raw/Inc)*Inc, Min, Max)
                Value = snapped
                local pct = (snapped-Min)/(Max-Min)
                QT(fill,  0.05, {Size = UDim2.fromScale(pct,1)})
                QT(knob,  0.05, {Position = UDim2.new(pct,0,0.5,0)})
                vl.Text = tostring(snapped)..Suffix
                pcall(Callback, snapped)
            end

            track.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingS = true; updSlider(inp)
                end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if draggingS and inp.UserInputType == Enum.UserInputType.MouseMovement then updSlider(inp) end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then draggingS = false end
            end)

            RegisterThemeListener(function(newT)
                QT(nl,    0.2, {TextColor3 = newT.TextAccent})
                QT(vl,    0.2, {TextColor3 = newT.TextDim})
                QT(track, 0.2, {BackgroundColor3 = newT.ToggleOff})
                QT(fill,  0.2, {BackgroundColor3 = newT.SliderFill})
                QT(ks,    0.2, {Color = newT.Accent})
            end)

            local obj = {
                Set = function(_, v)
                    v = math.clamp(v, Min, Max)
                    Value = v
                    local pct = (v-Min)/(Max-Min)
                    QT(fill, 0.1, {Size = UDim2.fromScale(pct,1)})
                    QT(knob, 0.1, {Position = UDim2.new(pct,0,0.5,0)})
                    vl.Text = tostring(v)..Suffix
                end,
                Get = function() return Value end,
            }
            Reg(id, obj.Get, function(v) obj:Set(tonumber(v)) end)
            return obj
        end

