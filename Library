function ViloniX:KeySystem(cfg)
    cfg = cfg or {}
    if cfg.Enabled == false then return end   -- ← DISABLE KEY SYSTEM

    local Keys     = cfg.Keys      or {}
    local Title    = cfg.Title     or "ViloniX"
    local SubTitle = cfg.SubTitle  or "Key Required"
    local Note     = cfg.Note      or "Get your key in our Discord"
    local FileName = cfg.FileName  or "ViloniXKey"
    local SaveKey  = cfg.SaveKey   ~= false
    local T        = Themes[cfg.Theme or "Default"] or Themes.Default

    -- Check saved key
    if SaveKey then
        local saved = FRead(FileName .. ".txt")
        if saved then
            for _, k in ipairs(Keys) do
                if saved:gsub("%s+","") == k then return end
            end
        end
    end

    local passed = false

    local overlay = Instance.new("Frame")
    overlay.Name               = "KeyOverlay"
    overlay.Size               = UDim2.fromScale(1,1)
    overlay.BackgroundColor3   = Color3.fromRGB(0,0,0)
    overlay.BackgroundTransparency = 0.4
    overlay.BorderSizePixel    = 0
    overlay.ZIndex             = 300
    overlay.Parent             = ScreenGui

    local win = Instance.new("Frame")
    win.Name               = "KeyWindow"
    win.AnchorPoint        = Vector2.new(0.5,0.5)
    win.Position           = UDim2.fromScale(0.5,0.5)
    win.Size               = UDim2.fromOffset(420, 235)
    win.BackgroundColor3   = T.KeyBg
    win.BorderSizePixel    = 0
    win.ZIndex             = 301
    win.Parent             = overlay
    local wc = Instance.new("UICorner"); wc.CornerRadius = UDim.new(0,12); wc.Parent = win
    local ws = Instance.new("UIStroke"); ws.Color = T.Accent; ws.Thickness = 1; ws.Transparency = 0.5; ws.Parent = win

    -- Top accent strip
    local strip = Instance.new("Frame")
    strip.Size = UDim2.new(1,0,0,3); strip.BackgroundColor3 = T.Accent
    strip.BorderSizePixel = 0; strip.ZIndex = 302; strip.Parent = win
    local sc = Instance.new("UICorner"); sc.CornerRadius = UDim.new(0,12); sc.Parent = strip

    -- Title / sub
    local function KLabel(text, size, color, bold, y, w)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, w or -30, 0, size+4)
        l.Position = UDim2.fromOffset(15, y)
        l.BackgroundTransparency = 1
        l.Text = text; l.TextColor3 = color
        l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
        l.TextSize = size; l.TextXAlignment = Enum.TextXAlignment.Left
        l.ZIndex = 302; l.Parent = win
        return l
    end
    KLabel(Title,    20, T.Accent,   true,  14)
    KLabel(SubTitle, 13, T.TextDim,  false, 38)

    -- Note pill
    if Note ~= "" then
        local notePill = Instance.new("Frame")
        notePill.Size = UDim2.new(1,-30,0,22); notePill.Position = UDim2.fromOffset(15,62)
        notePill.BackgroundColor3 = T.Surface; notePill.BorderSizePixel = 0
        notePill.ZIndex = 302; notePill.Parent = win
        local pc = Instance.new("UICorner"); pc.CornerRadius = UDim.new(0,6); pc.Parent = notePill
        local nl = Instance.new("TextLabel")
        nl.Size = UDim2.fromScale(1,1); nl.BackgroundTransparency = 1
        nl.Text = "ℹ  " .. Note; nl.TextColor3 = T.TextDim
        nl.Font = Enum.Font.Gotham; nl.TextSize = 11
        nl.ZIndex = 303; nl.Parent = notePill
    end

    -- Input
    local inputBg = Instance.new("Frame")
    inputBg.Size = UDim2.new(1,-30,0,42); inputBg.Position = UDim2.fromOffset(15,96)
    inputBg.BackgroundColor3 = T.Surface; inputBg.BorderSizePixel = 0
    inputBg.ZIndex = 302; inputBg.Parent = win
    local ic = Instance.new("UICorner"); ic.CornerRadius = UDim.new(0,9); ic.Parent = inputBg
    local istr = Instance.new("UIStroke"); istr.Color = T.Border; istr.Thickness = 1; istr.Parent = inputBg

    local keyBox = Instance.new("TextBox")
    keyBox.Size = UDim2.new(1,-20,1,0); keyBox.Position = UDim2.fromOffset(10,0)
    keyBox.BackgroundTransparency = 1; keyBox.Text = ""
    keyBox.PlaceholderText = "Enter your key..."; keyBox.PlaceholderColor3 = T.TextDim
    keyBox.TextColor3 = T.Text; keyBox.Font = Enum.Font.Gotham; keyBox.TextSize = 13
    keyBox.ZIndex = 303; keyBox.ClearTextOnFocus = false; keyBox.Parent = inputBg

    -- Status
    local statusLbl = Instance.new("TextLabel")
    statusLbl.Size = UDim2.new(1,-30,0,14); statusLbl.Position = UDim2.fromOffset(15,146)
    statusLbl.BackgroundTransparency = 1; statusLbl.Text = ""
    statusLbl.TextColor3 = Color3.fromRGB(255,80,80)
    statusLbl.Font = Enum.Font.Gotham; statusLbl.TextSize = 11
    statusLbl.TextXAlignment = Enum.TextXAlignment.Left
    statusLbl.ZIndex = 302; statusLbl.Parent = win

    -- Submit button
    local subBtn = Instance.new("TextButton")
    subBtn.Size = UDim2.new(1,-30,0,40); subBtn.Position = UDim2.fromOffset(15,162)
    subBtn.BackgroundColor3 = T.Accent; subBtn.BorderSizePixel = 0
    subBtn.Text = "Submit Key"; subBtn.TextColor3 = Color3.fromRGB(255,255,255)
    subBtn.Font = Enum.Font.GothamBold; subBtn.TextSize = 14
    subBtn.ZIndex = 302; subBtn.Parent = win
    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0,9); bc.Parent = subBtn

    MakeDraggable(win, win)

    -- Animate in
    win.Position = UDim2.new(0.5,0, 0.38,0)
    win.BackgroundTransparency = 1
    QT(win, 0.4, {Position = UDim2.fromScale(0.5,0.5), BackgroundTransparency = 0})

    local function shake()
        for _, d in ipairs({8,-8,6,-6,3,-3,0}) do
            QT(win, 0.04, {Position = UDim2.new(0.5,d,0.5,0)})
            task.wait(0.045)
        end
    end

    local function checkKey()
        local entered = keyBox.Text:gsub("%s+","")
        for _, k in ipairs(Keys) do
            if entered == k then
                if SaveKey then FWrite(FileName .. ".txt", entered) end
                statusLbl.Text = "✓ Key accepted!"
                statusLbl.TextColor3 = T.Accent
                QT(win, 0.35, {Position = UDim2.new(0.5,0,0.62,0), BackgroundTransparency = 1})
                task.wait(0.4)
                overlay:Destroy()
                passed = true
                return
            end
        end
        istr.Color = Color3.fromRGB(255,60,60)
        statusLbl.Text = "✗ Invalid key."
        task.spawn(shake)
        task.delay(1, function() istr.Color = T.Border end)
    end

    subBtn.MouseButton1Click:Connect(checkKey)
    keyBox.FocusLost:Connect(function(enter) if enter then checkKey() end end)
    subBtn.MouseEnter:Connect(function() QT(subBtn,0.15,{BackgroundColor3=T.AccentGlow}) end)
    subBtn.MouseLeave:Connect(function() QT(subBtn,0.15,{BackgroundColor3=T.Accent}) end)

    repeat task.wait() until passed or not overlay.Parent
end

-- ═══════════════════════════════════════════════════════
-- WINDOW
-- ═══════════════════════════════════════════════════════
function ViloniX:CreateWindow(cfg)
    cfg = cfg or {}
    local Title       = cfg.Title       or "ViloniX Library | v2"
    local SubTitle    = cfg.SubTitle    or ""
    local TabWidth    = cfg.TabWidth    or 155
    local Size        = cfg.Size        or UDim2.fromOffset(560, 380)
    local ThemeName   = cfg.Theme       or "Default"
    local ToggleKey   = cfg.ToggleKey   or Enum.KeyCode.RightControl
    local ConfigFolder= cfg.ConfigFolder or "ViloniX"
    local MinSize     = cfg.MinSize     or UDim2.fromOffset(Size.X.Offset, 44)

    -- Active theme (mutable)
    local T = Themes[ThemeName] or Themes.Default

    -- State storage for configs: {elementId → value}
    local ConfigState = {}
    local ElementRegistry = {} -- id → {get, set}
    local Window = {}

    -- ─── Build main frame ─────────────────────────────
    local mainFrame = Instance.new("Frame")
    mainFrame.Name               = "ViloniXWindow"
    mainFrame.AnchorPoint        = Vector2.new(0.5, 0.5)
    mainFrame.Position           = UDim2.fromScale(0.5, 0.5)
    mainFrame.Size               = UDim2.fromOffset(Size.X.Offset, 0)
    mainFrame.BackgroundColor3   = T.Background
    mainFrame.BorderSizePixel    = 0
    mainFrame.ClipsDescendants   = true
    mainFrame.Parent             = ScreenGui

    local mCorner = Instance.new("UICorner"); mCorner.CornerRadius = UDim.new(0,10); mCorner.Parent = mainFrame
    local mStroke = Instance.new("UIStroke"); mStroke.Color = T.Accent; mStroke.Thickness = 1; mStroke.Transparency = 0.55; mStroke.Parent = mainFrame

    -- ─── Top bar ──────────────────────────────────────
    local topBar = Instance.new("Frame")
    topBar.Name = "TopBar"; topBar.Size = UDim2.new(1,0,0,44)
    topBar.BackgroundColor3 = T.Sidebar; topBar.BorderSizePixel = 0; topBar.ZIndex = 2; topBar.Parent = mainFrame

    local topAccent = Instance.new("Frame")
    topAccent.Size = UDim2.new(1,0,0,2); topAccent.Position = UDim2.new(0,0,1,-2)
    topAccent.BackgroundColor3 = T.Accent; topAccent.BorderSizePixel = 0; topAccent.ZIndex = 3; topAccent.Parent = topBar

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1,-110,1,0); titleLbl.Position = UDim2.fromOffset(14,0)
    titleLbl.BackgroundTransparency = 1; titleLbl.RichText = true
    titleLbl.Font = Enum.Font.GothamBold; titleLbl.TextSize = 15
    titleLbl.TextColor3 = T.Text; titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.ZIndex = 3; titleLbl.Parent = topBar

    local function RefreshTitle()
        local plain, accent = Title:match("^(.-)(%|.*)$")
        if plain and accent then
            local r,g,b = T.Accent.R*255, T.Accent.G*255, T.Accent.B*255
            titleLbl.Text = plain .. string.format('<font color="rgb(%d,%d,%d)">%s</font>', r,g,b, accent)
        else
            titleLbl.Text = Title
        end
        titleLbl.TextColor3 = T.Text
    end
    RefreshTitle()

    -- Window control buttons
    local function MakeWinBtn(offsetX, icon, bg)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.fromOffset(26,26); btn.AnchorPoint = Vector2.new(1,0.5)
        btn.Position = UDim2.new(1,offsetX,0.5,0)
        btn.BackgroundColor3 = bg; btn.BorderSizePixel = 0
        btn.Text = icon; btn.TextColor3 = Color3.fromRGB(255,255,255)
        btn.Font = Enum.Font.GothamBold; btn.TextSize = 12
        btn.ZIndex = 4; btn.Parent = topBar
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1,0); c.Parent = btn
        return btn
    end

    local closeBtn = MakeWinBtn(-10, "✕", T.Accent)
    local minBtn   = MakeWinBtn(-42, "─", T.Surface)
    local hidBtn   = MakeWinBtn(-74, "⊡", T.Surface)

    local minimized = false
    local hidden    = false

    closeBtn.MouseButton1Click:Connect(function()
        QT(mainFrame, 0.25, {Size = UDim2.fromOffset(Size.X.Offset,0), BackgroundTransparency=1})
        task.wait(0.3); mainFrame:Destroy()
    end)
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        QT(mainFrame, 0.3, {Size = minimized and MinSize or Size})
    end)
    hidBtn.MouseButton1Click:Connect(function()
        hidden = not hidden
        QT(mainFrame, 0.25, {BackgroundTransparency = hidden and 1 or 0})
        topBar.Visible = not hidden
    end)

    -- GUI Toggle Keybind
    UserInputService.InputBegan:Connect(function(inp, gpe)
        if not gpe and inp.KeyCode == ToggleKey then
            hidden = not hidden
            QT(mainFrame, 0.25, {BackgroundTransparency = hidden and 1 or 0})
            topBar.Visible = not hidden
        end
    end)

    MakeDraggable(mainFrame, topBar)

    -- ─── Sidebar ──────────────────────────────────────
    local sidebar = Instance.new("Frame")
    sidebar.Name = "Sidebar"
    sidebar.Size = UDim2.new(0,TabWidth,1,-44); sidebar.Position = UDim2.fromOffset(0,44)
    sidebar.BackgroundColor3 = T.Sidebar; sidebar.BorderSizePixel = 0; sidebar.ZIndex = 2; sidebar.Parent = mainFrame

    local sideLayout = Instance.new("UIListLayout")
    sideLayout.Padding = UDim.new(0,3); sideLayout.SortOrder = Enum.SortOrder.LayoutOrder; sideLayout.Parent = sidebar

    local sidePad = Instance.new("UIPadding")
    sidePad.PaddingTop = UDim.new(0,8); sidePad.PaddingLeft = UDim.new(0,7)
    sidePad.PaddingRight = UDim.new(0,7); sidePad.Parent = sidebar

    -- ─── Content area ─────────────────────────────────
    local content = Instance.new("Frame")
    content.Size = UDim2.new(1,-TabWidth,1,-44); content.Position = UDim2.fromOffset(TabWidth,44)
    content.BackgroundTransparency = 1; content.ZIndex = 2; content.Parent = mainFrame

    local divider = Instance.new("Frame")
    divider.Size = UDim2.new(0,1,1,-44); divider.Position = UDim2.fromOffset(TabWidth,44)
    divider.BackgroundColor3 = T.Border; divider.BorderSizePixel = 0; divider.ZIndex = 3; divider.Parent = mainFrame

    local ActiveTab = nil

    -- Open animation
    QT(mainFrame, 0.45, {Size = Size}, Enum.EasingStyle.Back)

    -- ── Theme applier ─────────────────────────────────
    local ThemeListeners = {} -- functions to call when theme changes

    local function RegisterThemeListener(fn)
        table.insert(ThemeListeners, fn)
    end

    local function ApplyTheme(newThemeName)
        local newT = Themes[newThemeName]
        if not newT then return end
        T = newT
        -- Window frames
        QT(mainFrame, 0.25, {BackgroundColor3 = T.Background})
        QT(topBar,    0.25, {BackgroundColor3 = T.Sidebar})
        QT(sidebar,   0.25, {BackgroundColor3 = T.Sidebar})
        QT(topAccent, 0.25, {BackgroundColor3 = T.Accent})
        QT(divider,   0.25, {BackgroundColor3 = T.Border})
        QT(mStroke,   0.25, {Color = T.Accent})
        QT(closeBtn,  0.25, {BackgroundColor3 = T.Accent})
        QT(minBtn,    0.25, {BackgroundColor3 = T.Surface})
        QT(hidBtn,    0.25, {BackgroundColor3 = T.Surface})
        RefreshTitle()
        for _, fn in ipairs(ThemeListeners) do pcall(fn, T) end
    end

    -- ─── Config System ────────────────────────────────
    local function ConfigPath(name)
        return ConfigFolder .. "/" .. name .. ".json"
    end

    function Window:SaveConfig(name)
        name = name or "default"
        FMakeFolder(ConfigFolder)
        local data = {}
        for id, reg in pairs(ElementRegistry) do
            local ok2, val = pcall(reg.Get)
            if ok2 then data[id] = val end
        end
        FWrite(ConfigPath(name), HttpService:JSONEncode(data))
    end

    function Window:LoadConfig(name)
        name = name or "default"
        local raw = FRead(ConfigPath(name))
        if not raw then
            warn("[ViloniX] Config '" .. name .. "' not found.")
            return false
        end
        local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if not ok2 then
            warn("[ViloniX] Config '" .. name .. "' is corrupted.")
            return false
        end
        for id, val in pairs(data) do
            if ElementRegistry[id] then
                pcall(ElementRegistry[id].Set, val)
            end
        end
        return true
    end

    function Window:ListConfigs()
        local files = FList(ConfigFolder)
        local result = {}
        for _, f in ipairs(files) do
            local name = f:match("([^/\\]+)%.json$")
            if name then table.insert(result, name) end
        end
        return result
    end

    function Window:DeleteConfig(name)
        pcall(function()
            if delfile then delfile(ConfigPath(name)) end
        end)
    end

    -- ─── Watermark ────────────────────────────────────
    function Window:Watermark(cfg2)
        cfg2 = cfg2 or {}
        if cfg2.Enabled == false then return end
        local text = cfg2.Text or (Title .. "  |  v2")

        local wm = Instance.new("Frame")
        wm.Size = UDim2.fromOffset(#text * 7 + 20, 26)
        wm.Position = UDim2.fromOffset(10, 10)
        wm.BackgroundColor3 = T.Surface
        wm.BorderSizePixel = 0
        wm.ZIndex = 50
        wm.Parent = ScreenGui

        local wmc = Instance.new("UICorner"); wmc.CornerRadius = UDim.new(0,7); wmc.Parent = wm
        local wms = Instance.new("UIStroke"); wms.Color = T.Accent; wms.Thickness = 1; wms.Transparency = 0.5; wms.Parent = wm

        local wmLbl = Instance.new("TextLabel")
        wmLbl.Size = UDim2.fromScale(1,1); wmLbl.BackgroundTransparency = 1
        wmLbl.Text = text; wmLbl.TextColor3 = T.Text
        wmLbl.Font = Enum.Font.Gotham; wmLbl.TextSize = 12
        wmLbl.ZIndex = 51; wmLbl.Parent = wm
        MakeDraggable(wm, wm)

        RegisterThemeListener(function(newT)
            QT(wm,    0.2, {BackgroundColor3 = newT.Surface})
            QT(wms,   0.2, {Color = newT.Accent})
            QT(wmLbl, 0.2, {TextColor3 = newT.Text})
        end)
    end

    -- ─── Notify ───────────────────────────────────────
    function Window:Notify(cfg2)
        cfg2 = cfg2 or {}
        cfg2.Theme = T
        table.insert(NotifQueue, cfg2)
        ProcessNotifQueue()
    end

    -- ─── SetTheme ─────────────────────────────────────
    function Window:SetTheme(name)
        ApplyTheme(name)
    end

    -- ─── Toggle / Destroy ─────────────────────────────
    function Window:Toggle()
        hidden = not hidden
        QT(mainFrame, 0.25, {BackgroundTransparency = hidden and 1 or 0})
        topBar.Visible = not hidden
    end

    function Window:Destroy()
        ScreenGui:Destroy()
    end

    -- ═══════════════════════════════════════════════════
    -- TAB CREATION
    -- ═══════════════════════════════════════════════════
    function Window:CreateTab(name, icon)
        icon = icon or ""
        local Tab = {}

        -- Tab button
        local tabBtn = Instance.new("TextButton")
        tabBtn.Name = name; tabBtn.Size = UDim2.new(1,0,0,34)
        tabBtn.BackgroundColor3 = T.Sidebar; tabBtn.BorderSizePixel = 0
        tabBtn.Text = ""; tabBtn.ZIndex = 3; tabBtn.Parent = sidebar
        local tbc = Instance.new("UICorner"); tbc.CornerRadius = UDim.new(0,7); tbc.Parent = tabBtn

        local activeBar = Instance.new("Frame")
        activeBar.Size = UDim2.fromOffset(3,18); activeBar.AnchorPoint = Vector2.new(0,0.5)
        activeBar.Position = UDim2.new(0,0,0.5,0); activeBar.BackgroundColor3 = T.Accent
        activeBar.BorderSizePixel = 0; activeBar.BackgroundTransparency = 1
        activeBar.ZIndex = 4; activeBar.Parent = tabBtn
        local abc = Instance.new("UICorner"); abc.CornerRadius = UDim.new(1,0); abc.Parent = activeBar

        -- Icon label
        local iconLbl = Instance.new("TextLabel")
        iconLbl.Size = UDim2.fromOffset(20,34); iconLbl.Position = UDim2.fromOffset(10,0)
        iconLbl.BackgroundTransparency = 1; iconLbl.Text = icon
        iconLbl.TextColor3 = T.TabInactive; iconLbl.Font = Enum.Font.Gotham; iconLbl.TextSize = 14
        iconLbl.ZIndex = 4; iconLbl.Parent = tabBtn

        local tabLabel = Instance.new("TextLabel")
        local lblOffX = icon ~= "" and 32 or 12
        tabLabel.Size = UDim2.new(1,-lblOffX,1,0); tabLabel.Position = UDim2.fromOffset(lblOffX,0)
        tabLabel.BackgroundTransparency = 1; tabLabel.Text = name
        tabLabel.TextColor3 = T.TabInactive; tabLabel.Font = Enum.Font.Gotham; tabLabel.TextSize = 13
        tabLabel.TextXAlignment = Enum.TextXAlignment.Left
        tabLabel.ZIndex = 4; tabLabel.Parent = tabBtn

        -- Scroll frame for tab content
        local tabFrame = Instance.new("ScrollingFrame")
        tabFrame.Name = name.."Frame"; tabFrame.Size = UDim2.fromScale(1,1)
        tabFrame.BackgroundTransparency = 1; tabFrame.BorderSizePixel = 0
        tabFrame.ScrollBarThickness = 3; tabFrame.ScrollBarImageColor3 = T.Accent
        tabFrame.Visible = false; tabFrame.ZIndex = 3; tabFrame.Parent = content

        local tabLayout = Instance.new("UIListLayout")
        tabLayout.Padding = UDim.new(0,5); tabLayout.SortOrder = Enum.SortOrder.LayoutOrder; tabLayout.Parent = tabFrame

        local tabPad = Instance.new("UIPadding")
        tabPad.PaddingTop = UDim.new(0,10); tabPad.PaddingLeft = UDim.new(0,10)
        tabPad.PaddingRight = UDim.new(0,14); tabPad.PaddingBottom = UDim.new(0,10); tabPad.Parent = tabFrame

        tabLayout.Changed:Connect(function()
            tabFrame.CanvasSize = UDim2.fromOffset(0, tabLayout.AbsoluteContentSize.Y + 22)
        end)

        RegisterThemeListener(function(newT)
            QT(tabFrame, 0.2, {ScrollBarImageColor3 = newT.Accent})
            if ActiveTab and ActiveTab._frame == tabFrame then
                QT(tabBtn,    0.2, {BackgroundColor3 = newT.SurfaceHover})
                QT(tabLabel,  0.2, {TextColor3 = newT.Accent})
                QT(iconLbl,   0.2, {TextColor3 = newT.Accent})
                QT(activeBar, 0.2, {BackgroundColor3 = newT.Accent})
            else
                QT(tabBtn,   0.2, {BackgroundColor3 = newT.Sidebar})
                QT(tabLabel, 0.2, {TextColor3 = newT.TabInactive})
                QT(iconLbl,  0.2, {TextColor3 = newT.TabInactive})
            end
        end)

        local function activateTab()
            if ActiveTab then
                QT(ActiveTab._btn,   0.2, {BackgroundColor3 = T.Sidebar})
                QT(ActiveTab._lbl,   0.2, {TextColor3 = T.TabInactive})
                QT(ActiveTab._ico,   0.2, {TextColor3 = T.TabInactive})
                QT(ActiveTab._bar,   0.2, {BackgroundTransparency = 1})
                ActiveTab._lbl.Font = Enum.Font.Gotham
                ActiveTab._frame.Visible = false
            end
            ActiveTab = {_btn=tabBtn, _lbl=tabLabel, _ico=iconLbl, _bar=activeBar, _frame=tabFrame}
            QT(tabBtn,    0.2, {BackgroundColor3 = T.SurfaceHover})
            QT(tabLabel,  0.2, {TextColor3 = T.Accent})
            QT(iconLbl,   0.2, {TextColor3 = T.Accent})
            QT(activeBar, 0.2, {BackgroundTransparency = 0, BackgroundColor3 = T.Accent})
            tabLabel.Font  = Enum.Font.GothamBold
            tabFrame.Visible = true
        end

        tabBtn.MouseButton1Click:Connect(activateTab)
        tabBtn.MouseEnter:Connect(function()
            if not (ActiveTab and ActiveTab._btn == tabBtn) then
                QT(tabBtn, 0.12, {BackgroundColor3 = T.Surface})
            end
        end)
        tabBtn.MouseLeave:Connect(function()
            if not (ActiveTab and ActiveTab._btn == tabBtn) then
                QT(tabBtn, 0.12, {BackgroundColor3 = T.Sidebar})
            end
        end)

        if not ActiveTab then activateTab() end

        -- ── Element helpers ──────────────────────────
        local elemOrder = 0

        local function NewElem(height)
            elemOrder = elemOrder + 1
            local el = Instance.new("Frame")
            el.Size = UDim2.new(1,0,0,height); el.LayoutOrder = elemOrder
            el.BackgroundColor3 = T.Surface; el.BorderSizePixel = 0
            el.ZIndex = 4; el.Parent = tabFrame
            local ec = Instance.new("UICorner"); ec.CornerRadius = UDim.new(0,8); ec.Parent = el

            RegisterThemeListener(function(newT)
                QT(el, 0.2, {BackgroundColor3 = newT.Surface})
            end)
            return el
        end

        local function ELabel(parent, txt, fs, color, x, y, w, h, xa)
            local l = Instance.new("TextLabel")
            l.Size = UDim2.new(0,w,0,h); l.Position = UDim2.fromOffset(x,y)
            l.BackgroundTransparency = 1; l.Text = txt
            l.TextColor3 = color; l.Font = Enum.Font[fs] or Enum.Font.Gotham
            l.TextSize = 13; l.TextXAlignment = xa or Enum.TextXAlignment.Left
            l.ZIndex = parent.ZIndex+1; l.Parent = parent
            return l
        end

        -- Register element for config
        local function Reg(id, getfn, setfn)
            ElementRegistry[id] = {Get=getfn, Set=setfn}
        end

        -- ════════════════════════════════════════════
        -- SECTION
        -- ════════════════════════════════════════════
        function Tab:CreateSection(cfg2)
            cfg2 = cfg2 or {}
            local text = cfg2.Text or "Section"
            elemOrder = elemOrder + 1
            local el = Instance.new("Frame")
            el.Size = UDim2.new(1,0,0,24); el.LayoutOrder = elemOrder
            el.BackgroundTransparency = 1; el.ZIndex = 4; el.Parent = tabFrame

            local line = Instance.new("Frame")
            line.Size = UDim2.new(1,0,0,1); line.Position = UDim2.new(0,0,1,-1)
            line.BackgroundColor3 = T.Border; line.BorderSizePixel = 0; line.ZIndex = 5; line.Parent = el

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.fromScale(1,1); lbl.BackgroundTransparency = 1
            lbl.Text = text:upper(); lbl.TextColor3 = T.SectionText
            lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 10
            lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.ZIndex = 5; lbl.Parent = el

            RegisterThemeListener(function(newT)
                QT(line, 0.2, {BackgroundColor3 = newT.Border})
                QT(lbl,  0.2, {TextColor3 = newT.SectionText})
            end)
        end

        -- ════════════════════════════════════════════
        -- SEPARATOR
        -- ════════════════════════════════════════════
        function Tab:CreateSeparator(cfg2)
            cfg2 = cfg2 or {}
            local label = cfg2.Text or ""
            elemOrder = elemOrder + 1
            local el = Instance.new("Frame")
            el.Size = UDim2.new(1,0,0,18); el.LayoutOrder = elemOrder
            el.BackgroundTransparency = 1; el.ZIndex = 4; el.Parent = tabFrame

            local line = Instance.new("Frame")
            line.Size = UDim2.new(1,0,0,1); line.Position = UDim2.new(0,0,0.5,0)
            line.BackgroundColor3 = T.Border; line.BorderSizePixel = 0; line.ZIndex = 5; line.Parent = el

            if label ~= "" then
                local bg = Instance.new("Frame")
                bg.Size = UDim2.fromOffset(#label*7+12,16); bg.AnchorPoint = Vector2.new(0.5,0.5)
                bg.Position = UDim2.fromScale(0.5,0.5); bg.BackgroundColor3 = T.Background
                bg.BorderSizePixel = 0; bg.ZIndex = 6; bg.Parent = line
                local sepLbl = Instance.new("TextLabel")
                sepLbl.Size = UDim2.fromScale(1,1); sepLbl.BackgroundTransparency = 1
                sepLbl.Text = label; sepLbl.TextColor3 = T.TextDim
                sepLbl.Font = Enum.Font.Gotham; sepLbl.TextSize = 11; sepLbl.ZIndex = 7; sepLbl.Parent = bg
                RegisterThemeListener(function(newT)
                    QT(bg,     0.2, {BackgroundColor3 = newT.Background})
                    QT(sepLbl, 0.2, {TextColor3 = newT.TextDim})
                end)
            end

            RegisterThemeListener(function(newT)
                QT(line, 0.2, {BackgroundColor3 = newT.Border})
            end)
        end

        -- ════════════════════════════════════════════
        -- LABEL
        -- ════════════════════════════════════════════
        function Tab:CreateLabel(cfg2)
            cfg2 = cfg2 or {}
            local text = cfg2.Text or "Label"
            local el = NewElem(34)

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1,-24,1,0); lbl.Position = UDim2.fromOffset(12,0)
            lbl.BackgroundTransparency = 1; lbl.Text = text
            lbl.TextColor3 = T.TextDim; lbl.Font = Enum.Font.Gotham; lbl.TextSize = 12
            lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.RichText = true
            lbl.ZIndex = el.ZIndex+1; lbl.Parent = el

            RegisterThemeListener(function(newT) QT(lbl, 0.2, {TextColor3 = newT.TextDim}) end)
            return {Set = function(_,v) lbl.Text = v end}
        end

        -- ════════════════════════════════════════════
        -- PARAGRAPH
        -- ════════════════════════════════════════════
        function Tab:CreateParagraph(cfg2)
            cfg2 = cfg2 or {}
            local title   = cfg2.Title   or ""
            local content = cfg2.Content or ""

            local el = NewElem(10) -- height adjusted below

            local tLbl, cLbl
            local yOff = 8
            if title ~= "" then
                tLbl = Instance.new("TextLabel")
                tLbl.Size = UDim2.new(1,-24,0,18); tLbl.Position = UDim2.fromOffset(12,yOff)
                tLbl.BackgroundTransparency = 1; tLbl.Text = title
                tLbl.TextColor3 = T.TextAccent; tLbl.Font = Enum.Font.GothamBold; tLbl.TextSize = 13
                tLbl.TextXAlignment = Enum.TextXAlignment.Left; tLbl.ZIndex = el.ZIndex+1; tLbl.Parent = el
