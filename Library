-- UTILITY / CONFIG FUNCTIONS
-- ═══════════════════════════════════════════

function ViloniX:SetConfig(cfg)
    self.Config = cfg
end

function ViloniX:SaveConfig()
    if not self.Config.Enabled then return end
    if makefolder and not isfolder(self.Config.Folder) then
        pcall(function() makefolder(self.Config.Folder) end)
    end
    local data = HttpService:JSONEncode(self.Flags)
    pcall(function()
        writefile(self.Config.Folder.."/"..self.Config.File..".json", data)
    end)
end

function ViloniX:LoadConfig()
    if not self.Config.Enabled then return end
    local path = self.Config.Folder.."/"..self.Config.File..".json"
    if isfile and isfile(path) then
        local content = readfile(path)
        local decoded = HttpService:JSONDecode(content)
        for k,v in pairs(decoded) do
            self.Flags[k] = v
        end
    end
end

-- Fast tween
local function QuickTween(obj, t, props)
    TweenService:Create(obj, TweenInfo.new(t, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end

-- Clamps value
local function clamp(val, min, max)
    return val < min and min or (val > max and max or val)
end

