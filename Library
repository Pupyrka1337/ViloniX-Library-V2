            arrow.ZIndex = 5
            arrow.Parent = el

            -- Dropdown list
            local dropFrame = Instance.new("Frame")
            dropFrame.Size = UDim2.new(1, 0, 0, 0)
            dropFrame.Position = UDim2.new(0, 0, 1, 4)
            dropFrame.BackgroundColor3 = Theme.Surface
            dropFrame.BorderSizePixel = 0
            dropFrame.ClipsDescendants = true
            dropFrame.ZIndex = 20
            dropFrame.Visible = false
            dropFrame.Parent = el

            local dfCorner = Instance.new("UICorner")
            dfCorner.CornerRadius = UDim.new(0, 8)
            dfCorner.Parent = dropFrame

            local dfStroke = Instance.new("UIStroke")
            dfStroke.Color = Theme.Border
            dfStroke.Thickness = 1
            dfStroke.Parent = dropFrame

            local dfLayout = Instance.new("UIListLayout")
            dfLayout.SortOrder = Enum.SortOrder.LayoutOrder
            dfLayout.Parent = dropFrame

            local optionHeight = 32
            local totalH = #Options * optionHeight

            for i, opt in ipairs(Options) do
                local optBtn = Instance.new("TextButton")
                optBtn.Size = UDim2.new(1, 0, 0, optionHeight)
                optBtn.BackgroundTransparency = 1
                optBtn.Text = opt
                optBtn.TextColor3 = (opt == Current) and Theme.Accent or Theme.Text
                optBtn.Font = Enum.Font.Gotham
                optBtn.TextSize = 13
                optBtn.ZIndex = 21
                optBtn.Parent = dropFrame

                optBtn.MouseEnter:Connect(function()
                    QuickTween(optBtn, 0.1, {BackgroundTransparency = 0.85})
                    optBtn.BackgroundColor3 = Theme.Accent
                end)
                optBtn.MouseLeave:Connect(function()
                    QuickTween(optBtn, 0.1, {BackgroundTransparency = 1})
                end)

                optBtn.MouseButton1Click:Connect(function()
                    if not Multi then
                        selected = opt
                        Current = opt
                        -- Reset all option colors
                        for _, c in ipairs(dropFrame:GetChildren()) do
                            if c:IsA("TextButton") then
                                c.TextColor3 = Theme.Text
                            end
                        end
                        optBtn.TextColor3 = Theme.Accent
                        open = false
                        QuickTween(dropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 0)})
                        QuickTween(arrow, 0.2, {Rotation = 0})
                        task.wait(0.22)
                        dropFrame.Visible = false
                        pcall(Callback, opt)
                    else
                        if selected[opt] then
                            selected[opt] = nil
                            optBtn.TextColor3 = Theme.Text
                        else
                            selected[opt] = true
                            optBtn.TextColor3 = Theme.Accent
                        end
                        local list = {}
                        for k in pairs(selected) do table.insert(list, k) end
                        pcall(Callback, list)
                    end
                end)
            end

            el.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    open = not open
                    if open then
                        dropFrame.Visible = true
                        dropFrame.Size = UDim2.new(1, 0, 0, 0)
                        QuickTween(dropFrame, 0.25, {Size = UDim2.new(1, 0, 0, totalH)})
                        QuickTween(arrow, 0.2, {Rotation = 180})
                    else
                        QuickTween(dropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 0)})
                        QuickTween(arrow, 0.2, {Rotation = 0})
                        task.wait(0.22)
                        dropFrame.Visible = false
                    end
                end
            end)

            return {
                Set = function(self, v)
                    Current = v
                    selected = v
                end,
                Refresh = function(self, newOpts)
                    Options = newOpts
                    for _, c in ipairs(dropFrame:GetChildren()) do
                        if c:IsA("TextButton") then c:Destroy() end
                    end
                    -- Rebuild options
                    for _, opt in ipairs(newOpts) do
                        local optBtn = Instance.new("TextButton")
                        optBtn.Size = UDim2.new(1, 0, 0, optionHeight)
                        optBtn.BackgroundTransparency = 1
                        optBtn.Text = opt
                        optBtn.TextColor3 = Theme.Text
                        optBtn.Font = Enum.Font.Gotham
                        optBtn.TextSize = 13
                        optBtn.ZIndex = 21
                        optBtn.Parent = dropFrame
                    end
                end
            }
        end

