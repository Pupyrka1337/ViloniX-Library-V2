local function Tween(obj, info, props)
    TweenService:Create(obj, info, props):Play()
end

local function QT(obj, t, props, style, dir)
    Tween(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
end

local function MakeDraggable(frame, handle)
    local dragging, dragInput, dragStart, startPos
    handle.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            dragStart = inp.Position
            startPos  = frame.Position
            inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    handle.InputChanged:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = inp
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if inp == dragInput and dragging then
            local d = inp.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
end

local function Ripple(parent, x, y, clr)
    local r = Instance.new("Frame")
    r.AnchorPoint  = Vector2.new(0.5, 0.5)
    r.BackgroundColor3 = clr or Color3.fromRGB(255,255,255)
    r.BackgroundTransparency = 0.75
    r.BorderSizePixel = 0
    r.ZIndex = parent.ZIndex + 8
    local pos = parent.AbsolutePosition
    r.Position = UDim2.fromOffset(x - pos.X, y - pos.Y)
    r.Size     = UDim2.fromOffset(0, 0)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1,0)
    c.Parent = r
    r.Parent = parent
    local s = math.max(parent.AbsoluteSize.X, parent.AbsoluteSize.Y) * 2.5
    Tween(r, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(s, s),
        BackgroundTransparency = 1,
    })
    game:GetService("Debris"):AddItem(r, 0.6)
end

local function FS(name, size) -- FontStyle
    return {Font = Enum.Font[name], TextSize = size}
end

-- File helpers (graceful fallback if not executor)
local function FWrite(path, data)
    pcall(function()
        if writefile then writefile(path, data) end
    end)
end
local function FRead(path)
    local ok, res = pcall(function()
        if readfile and isfile and isfile(path) then
            return readfile(path)
        end
    end)
    return ok and res or nil
end
local function FExists(path)
    local ok, res = pcall(function()
        return isfile and isfile(path)
    end)
    return ok and res or false
end
local function FList(folder)
    local ok, res = pcall(function()
        if listfiles and isfolder then
            if not isfolder(folder) then
                if makefolder then makefolder(folder) end
            end
            return listfiles(folder)
        end
    end)
    return (ok and res) or {}
end
local function FMakeFolder(folder)
    pcall(function()
        if makefolder and not (isfolder and isfolder(folder)) then
            makefolder(folder)
        end
    end)
end

