            ibg.ZIndex = el.ZIndex+1; ibg.Parent = el
            local ibc = Instance.new("UICorner"); ibc.CornerRadius = UDim.new(0,7); ibc.Parent = ibg
            local ibs = Instance.new("UIStroke"); ibs.Color = T.Border; ibs.Thickness = 1; ibs.Parent = ibg

            local tb = Instance.new("TextBox")
            tb.Size = UDim2.new(1,-16,1,0); tb.Position = UDim2.fromOffset(8,0)
            tb.BackgroundTransparency = 1; tb.Text = Default
            tb.PlaceholderText = Placeholder; tb.PlaceholderColor3 = T.TextDim
            tb.TextColor3 = T.Text; tb.Font = Enum.Font.Gotham; tb.TextSize = 12
            tb.ClearTextOnFocus = false; tb.ZIndex = el.ZIndex+2; tb.Parent = ibg

            tb.Focused:Connect(function() QT(ibs,0.15,{Color=T.Accent}) end)
            tb.FocusLost:Connect(function(enter)
                QT(ibs,0.15,{Color=T.Border})
                if enter then pcall(Callback, tb.Text) end
            end)

            RegisterThemeListener(function(newT)
                QT(nl,  0.2, {TextColor3 = newT.TextAccent})
                QT(ibg, 0.2, {BackgroundColor3 = newT.Background})
                QT(ibs, 0.2, {Color = newT.Border})
                QT(tb,  0.2, {TextColor3 = newT.Text})
                tb.PlaceholderColor3 = newT.TextDim
            end)

            local obj = {
                Set = function(_, v) tb.Text = v end,
                Get = function() return tb.Text end,
            }
            Reg(id, obj.Get, function(v) obj:Set(v) end)
            return obj
        end

        -- ════════════════════════════════════════════
        -- KEYBIND
        -- ════════════════════════════════════════════
        function Tab:CreateKeybind(cfg2)
            cfg2 = cfg2 or {}
            local Name    = cfg2.Name    or "Keybind"
            local Default = cfg2.CurrentKeybind or "F"
            local HoldMode= cfg2.HoldToToggle or false
            local Callback= cfg2.Callback or function() end
            local id      = cfg2.Id or (Name..math.random(1,99999))

            local el = NewElem(40)
            local listening = false
            local current = Default

            local nl = Instance.new("TextLabel")
            nl.Size = UDim2.new(1,-80,1,0); nl.Position = UDim2.fromOffset(12,0)
            nl.BackgroundTransparency = 1; nl.Text = Name
            nl.TextColor3 = T.TextAccent; nl.Font = Enum.Font.GothamBold; nl.TextSize = 13
            nl.TextXAlignment = Enum.TextXAlignment.Left; nl.ZIndex = el.ZIndex+1; nl.Parent = el

            local kBtn = Instance.new("TextButton")
            kBtn.Size = UDim2.fromOffset(70,26); kBtn.AnchorPoint = Vector2.new(1,0.5)
            kBtn.Position = UDim2.new(1,-10,0.5,0)
            kBtn.BackgroundColor3 = T.Background; kBtn.BorderSizePixel = 0
            kBtn.Text = "[" .. current .. "]"; kBtn.TextColor3 = T.Accent
            kBtn.Font = Enum.Font.GothamBold; kBtn.TextSize = 12
            kBtn.ZIndex = el.ZIndex+1; kBtn.Parent = el
            local kbc = Instance.new("UICorner"); kbc.CornerRadius = UDim.new(0,6); kbc.Parent = kBtn
            local kbs = Instance.new("UIStroke"); kbs.Color = T.Border; kbs.Thickness = 1; kbs.Parent = kBtn

            kBtn.MouseButton1Click:Connect(function()
                listening = true
                kBtn.Text = "..."; kBtn.TextColor3 = T.TextDim
                QT(kbs, 0.15, {Color = T.Accent})
            end)

            UserInputService.InputBegan:Connect(function(inp, gpe)
                if listening then
                    if inp.UserInputType == Enum.UserInputType.Keyboard then
                        current = inp.KeyCode.Name
                        kBtn.Text = "[" .. current .. "]"
                        kBtn.TextColor3 = T.Accent
                        listening = false
                        QT(kbs, 0.15, {Color = T.Border})
                    end
                elseif not gpe and inp.UserInputType == Enum.UserInputType.Keyboard then
                    if inp.KeyCode.Name == current then pcall(Callback) end
                end
            end)

            RegisterThemeListener(function(newT)
                QT(nl,   0.2, {TextColor3 = newT.TextAccent})
                QT(kBtn, 0.2, {BackgroundColor3 = newT.Background, TextColor3 = newT.Accent})
                QT(kbs,  0.2, {Color = newT.Border})
            end)

            local obj = {
                Set = function(_, v) current = v; kBtn.Text = "[" .. v .. "]" end,
                Get = function() return current end,
            }
            Reg(id, obj.Get, function(v) obj:Set(v) end)
            return obj
        end

        -- ════════════════════════════════════════════
        -- COLOR PICKER  (simple HSV)
        -- ════════════════════════════════════════════
        function Tab:CreateColorPicker(cfg2)
            cfg2 = cfg2 or {}
            local Name     = cfg2.Name     or "Color"
            local Default  = cfg2.Default  or Color3.fromRGB(255,0,128)
            local Callback = cfg2.Callback or function() end
            local id       = cfg2.Id       or (Name..math.random(1,99999))

            local Value = Default
            local H, S, V2 = Color3.toHSV(Default)
            local open = false

            local el = NewElem(40)

            local nl = Instance.new("TextLabel")
            nl.Size = UDim2.new(1,-56,1,0); nl.Position = UDim2.fromOffset(12,0)
            nl.BackgroundTransparency = 1; nl.Text = Name
            nl.TextColor3 = T.TextAccent; nl.Font = Enum.Font.GothamBold; nl.TextSize = 13
            nl.TextXAlignment = Enum.TextXAlignment.Left; nl.ZIndex = el.ZIndex+1; nl.Parent = el

            local preview = Instance.new("TextButton")
            preview.Size = UDim2.fromOffset(32,24); preview.AnchorPoint = Vector2.new(1,0.5)
            preview.Position = UDim2.new(1,-10,0.5,0)
            preview.BackgroundColor3 = Value; preview.BorderSizePixel = 0; preview.Text = ""
            preview.ZIndex = el.ZIndex+1; preview.Parent = el
            local pvc = Instance.new("UICorner"); pvc.CornerRadius = UDim.new(0,6); pvc.Parent = preview
            local pvs = Instance.new("UIStroke"); pvs.Color = T.Border; pvs.Thickness = 1; pvs.Parent = preview

            -- Picker popup
            local picker = Instance.new("Frame")
            picker.Size = UDim2.new(1,0,0,0); picker.Position = UDim2.new(0,0,1,4)
            picker.BackgroundColor3 = T.Background; picker.BorderSizePixel = 0
            picker.ClipsDescendants = true; picker.ZIndex = 25
            picker.Visible = false; picker.Parent = el
            local pcc = Instance.new("UICorner"); pcc.CornerRadius = UDim.new(0,8); pcc.Parent = picker
            local pcs = Instance.new("UIStroke"); pcs.Color = T.Border; pcs.Thickness = 1; pcs.Parent = picker

            -- Hue bar
            local hueBar = Instance.new("Frame")
            hueBar.Size = UDim2.new(1,-16,0,16); hueBar.Position = UDim2.fromOffset(8,8)
            hueBar.BorderSizePixel = 0; hueBar.ZIndex = 26; hueBar.Parent = picker

            -- Fill hue bar with gradient
            local hueGrad = Instance.new("UIGradient")
            hueGrad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0,    Color3.fromHSV(0,1,1)),
                ColorSequenceKeypoint.new(0.167,Color3.fromHSV(0.167,1,1)),
                ColorSequenceKeypoint.new(0.333,Color3.fromHSV(0.333,1,1)),
                ColorSequenceKeypoint.new(0.5,  Color3.fromHSV(0.5,1,1)),
                ColorSequenceKeypoint.new(0.667,Color3.fromHSV(0.667,1,1)),
                ColorSequenceKeypoint.new(0.833,Color3.fromHSV(0.833,1,1)),
                ColorSequenceKeypoint.new(1,    Color3.fromHSV(1,1,1)),
            })
            hueGrad.Parent = hueBar
            local hc = Instance.new("UICorner"); hc.CornerRadius = UDim.new(0,4); hc.Parent = hueBar

            -- Sat/Val field
            local svField = Instance.new("Frame")
            svField.Size = UDim2.new(1,-16,0,80); svField.Position = UDim2.fromOffset(8,32)
            svField.BackgroundColor3 = Color3.fromHSV(H,1,1)
            svField.BorderSizePixel = 0; svField.ZIndex = 26; svField.Parent = picker
            local sfc = Instance.new("UICorner"); sfc.CornerRadius = UDim.new(0,4); sfc.Parent = svField

            -- White → transparent overlay (saturation)
            local satGrad = Instance.new("Frame")
            satGrad.Size = UDim2.fromScale(1,1); satGrad.BackgroundTransparency = 1
            satGrad.ZIndex = 27; satGrad.Parent = svField
            local sg = Instance.new("UIGradient")
            sg.Color = ColorSequence.new(Color3.fromRGB(255,255,255), Color3.fromRGB(255,255,255))
            sg.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0,0), NumberSequenceKeypoint.new(1,1)})
            sg.Parent = satGrad

            -- Black overlay (value)
            local valGrad = Instance.new("Frame")
            valGrad.Size = UDim2.fromScale(1,1); valGrad.BackgroundTransparency = 1
            valGrad.Rotation = 90; valGrad.ZIndex = 28; valGrad.Parent = svField
            local vg = Instance.new("UIGradient")
            vg.Color = ColorSequence.new(Color3.fromRGB(0,0,0), Color3.fromRGB(0,0,0))
            vg.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0,1), NumberSequenceKeypoint.new(1,0)})
            vg.Parent = valGrad

            -- Cursor
            local cursor = Instance.new("Frame")
            cursor.Size = UDim2.fromOffset(12,12); cursor.AnchorPoint = Vector2.new(0.5,0.5)
            cursor.BackgroundColor3 = Color3.fromRGB(255,255,255); cursor.BorderSizePixel = 0
            cursor.ZIndex = 29; cursor.Parent = svField
            local cuc = Instance.new("UICorner"); cuc.CornerRadius = UDim.new(1,0); cuc.Parent = cursor
            local cus = Instance.new("UIStroke"); cus.Color = Color3.fromRGB(0,0,0); cus.Thickness = 1; cus.Parent = cursor
            cursor.Position = UDim2.new(S, 0, 1-V2, 0)

            -- Hue knob
            local hKnob = Instance.new("Frame")
            hKnob.Size = UDim2.fromOffset(6,20); hKnob.AnchorPoint = Vector2.new(0.5,0.5)
            hKnob.BackgroundColor3 = Color3.fromRGB(255,255,255); hKnob.BorderSizePixel = 0
            hKnob.ZIndex = 27; hKnob.Parent = hueBar
            hKnob.Position = UDim2.new(H,0,0.5,0)
            local hkc = Instance.new("UICorner"); hkc.CornerRadius = UDim.new(0,2); hkc.Parent = hKnob

            -- Hex input
            local hexBg = Instance.new("Frame")
            hexBg.Size = UDim2.new(1,-16,0,24); hexBg.Position = UDim2.fromOffset(8,120)
            hexBg.BackgroundColor3 = T.Surface; hexBg.BorderSizePixel = 0; hexBg.ZIndex = 26; hexBg.Parent = picker
            local hxc = Instance.new("UICorner"); hxc.CornerRadius = UDim.new(0,5); hxc.Parent = hexBg

            local function colorToHex(c)
                return string.format("#%02X%02X%02X", math.round(c.R*255), math.round(c.G*255), math.round(c.B*255))
            end

            local hexBox = Instance.new("TextBox")
            hexBox.Size = UDim2.fromScale(1,1); hexBox.BackgroundTransparency = 1
            hexBox.Text = colorToHex(Value); hexBox.TextColor3 = T.Text
            hexBox.Font = Enum.Font.Code; hexBox.TextSize = 11; hexBox.ZIndex = 27; hexBox.Parent = hexBg

            local function applyColor()
                Value = Color3.fromHSV(H, S, V2)
                preview.BackgroundColor3 = Value
                svField.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
                hexBox.Text = colorToHex(Value)
                pcall(Callback, Value)
            end

            -- Drag hue
            local draggingH = false
            hueBar.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingH = true
                    H = math.clamp((inp.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
                    hKnob.Position = UDim2.new(H,0,0.5,0)
                    applyColor()
                end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if draggingH and inp.UserInputType == Enum.UserInputType.MouseMovement then
                    H = math.clamp((inp.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
                    hKnob.Position = UDim2.new(H,0,0.5,0)
                    applyColor()
                end
            end)

            -- Drag SV
            local draggingSV = false
            svField.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingSV = true
                    S  = math.clamp((inp.Position.X - svField.AbsolutePosition.X) / svField.AbsoluteSize.X, 0, 1)
                    V2 = 1 - math.clamp((inp.Position.Y - svField.AbsolutePosition.Y) / svField.AbsoluteSize.Y, 0, 1)
                    cursor.Position = UDim2.new(S,0,1-V2,0)
                    applyColor()
                end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if draggingSV and inp.UserInputType == Enum.UserInputType.MouseMovement then
                    S  = math.clamp((inp.Position.X - svField.AbsolutePosition.X) / svField.AbsoluteSize.X, 0, 1)
                    V2 = 1 - math.clamp((inp.Position.Y - svField.AbsolutePosition.Y) / svField.AbsoluteSize.Y, 0, 1)
                    cursor.Position = UDim2.new(S,0,1-V2,0)
                    applyColor()
                end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingH = false; draggingSV = false
                end
            end)

            preview.MouseButton1Click:Connect(function()
                open = not open
                if open then
                    picker.Visible = true; picker.Size = UDim2.new(1,0,0,0)
                    QT(picker, 0.25, {Size = UDim2.new(1,0,0,152)})
                else
                    QT(picker, 0.2, {Size = UDim2.new(1,0,0,0)})
                    task.delay(0.22, function() picker.Visible = false end)
                end
            end)

            RegisterThemeListener(function(newT)
                QT(nl,     0.2, {TextColor3 = newT.TextAccent})
                QT(pvs,    0.2, {Color = newT.Border})
                QT(picker, 0.2, {BackgroundColor3 = newT.Background})
                QT(hexBg,  0.2, {BackgroundColor3 = newT.Surface})
                QT(hexBox, 0.2, {TextColor3 = newT.Text})
            end)

            local obj = {
                Set = function(_, c)
                    Value = c; H, S, V2 = Color3.toHSV(c)
                    preview.BackgroundColor3 = c
                    svField.BackgroundColor3 = Color3.fromHSV(H,1,1)
                    cursor.Position = UDim2.new(S,0,1-V2,0)
                    hKnob.Position = UDim2.new(H,0,0.5,0)
                    hexBox.Text = colorToHex(c)
                end,
                Get = function() return Value end,
            }
            Reg(id, function()
                return {Value.R, Value.G, Value.B}
            end, function(v)
                if type(v) == "table" then
                    obj:Set(Color3.new(v[1], v[2], v[3]))
                end
            end)
            return obj
        end

        return Tab
    end -- CreateTab

    return Window
end -- CreateWindow

return ViloniX
