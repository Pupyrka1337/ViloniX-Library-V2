-- ═══════════════════════════════════════════
-- KEY SYSTEM (can be disabled)
-- ═══════════════════════════════════════════
function ViloniX:KeySystem(config)
    config = config or {}

    if config.Enabled == false then
        return true
    end

    local Keys = config.Keys or {}
    local Title = config.Title or "Key Required"
    local SubTitle = config.SubTitle or ""
    local Note = config.Note or ""
    local FileName = config.FileName or "ViloniXKey"
    local SaveKey = config.SaveKey ~= false

    -- check saved
    if SaveKey then
        local saved = nil
        if isfile and readfile then
            if isfile(FileName..".txt") then
                saved = readfile(FileName..".txt")
            end
        end
        if saved and table.find(Keys, saved) then
            return true
        end
    end

    local passed = false

    local overlay = Instance.new("Frame")
    overlay.Size = UDim2.fromScale(1,1)
    overlay.BackgroundTransparency = 0.45
    overlay.BackgroundColor3 = Color3.new(0,0,0)
    overlay.Parent = ScreenGui

    local window = Instance.new("Frame")
    window.Size = UDim2.fromOffset(420,220)
    window.Position = UDim2.new(0.5,0,0.5,0)
    window.AnchorPoint = Vector2.new(0.5,0.5)
    window.BackgroundColor3 = Color3.fromRGB(25,25,25)
    window.Parent = overlay

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1,0,0,30)
    titleLbl.Position = UDim2.fromOffset(0,10)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = Title
    titleLbl.TextColor3 = Color3.new(1,1,1)
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 20
    titleLbl.Parent = window

    local input = Instance.new("TextBox")
    input.Size = UDim2.new(1,-40,0,32)
    input.Position = UDim2.fromOffset(20,60)
    input.PlaceholderText = "Enter Key..."
    input.TextColor3 = Color3.new(1,1,1)
    input.Parent = window

    local submit = Instance.new("TextButton")
    submit.Size = UDim2.new(1,-40,0,32)
    submit.Position = UDim2.fromOffset(20,110)
    submit.Text = "Submit"
    submit.Parent = window

    local status = Instance.new("TextLabel")
    status.Position = UDim2.fromOffset(20,150)
    status.Size = UDim2.new(1,-40,0,18)
    status.TextColor3 = Color3.new(1,0,0)
    status.Parent = window

    submit.MouseButton1Click:Connect(function()
        local key = input.Text
        if table.find(Keys, key) then
            if SaveKey then
                pcall(function() writefile(FileName..".txt", key) end)
            end
            status.TextColor3 = Color3.new(0,1,0)
            status.Text = "Key Accepted"
            task.wait(0.35)
            overlay:Destroy()
            passed = true
        else
            status.Text = "Invalid Key"
        end
    end)

    repeat task.wait() until passed
    return true
end

-- ═══════════════════════════════════════════
-- WINDOW
-- ═══════════════════════════════════════════
function ViloniX:CreateWindow(config)
    config = config or {}
    local Win = {}

    local mainFrame = Instance.new("Frame")
    mainFrame.Size = config.Size or UDim2.fromOffset(600,400)
    mainFrame.Position = UDim2.new(0.5,0,0.5,0)
    mainFrame.AnchorPoint = Vector2.new(0.5,0.5)
    mainFrame.BackgroundColor3 = Color3.fromRGB(30,30,30)
    mainFrame.Parent = ScreenGui

    function Win:CreateTab(name)
        local Tab = {}

        function Tab:CreateSlider(cfg)
            cfg = cfg or {}
            local Name = cfg.Name or "Slider"
            local Range = cfg.Range or {0,100}
            local Min,Max = Range[1],Range[2]
            local Flag = cfg.Flag or Name
            local Value = ViloniX.Flags[Flag] or cfg.CurrentValue or Min

            ViloniX.Flags[Flag] = Value

            local element = {}
            function element:Set(v)
                v = clamp(v, Min, Max)
                ViloniX.Flags[Flag] = v
                cfg.Callback(v)
                ViloniX:SaveConfig()
            end
            return element
        end

        function Tab:CreateToggle(cfg)
            cfg = cfg or {}
            local Flag = cfg.Flag or cfg.Name
            local Value = ViloniX.Flags[Flag]
            if Value == nil then Value = cfg.CurrentValue or false end
            ViloniX.Flags[Flag] = Value

            local element = {}
            function element:Set(v)
                ViloniX.Flags[Flag] = v
                cfg.Callback(v)
                ViloniX:SaveConfig()
            end
            return element
        end

        function Tab:CreateDropdown(cfg)
            cfg = cfg or {}
            local Flag = cfg.Flag or cfg.Name
            local Value = ViloniX.Flags[Flag] or (cfg.CurrentOption and cfg.CurrentOption[1]) or cfg.Options[1]
            ViloniX.Flags[Flag] = Value

            local element = {}
            function element:Set(v)
                ViloniX.Flags[Flag] = v
                cfg.Callback(v)
                ViloniX:SaveConfig()
            end
            return element
        end

        function Tab:CreateButton(cfg)
            cfg = cfg or {}
            local element = {}
            function element:Fire()
                cfg.Callback()
            end
            return element
        end

        return Tab
    end

    function Win:Notify(cfg)
        cfg = cfg or {}
        print("[ViloniX Notify] "..(cfg.Title or "")..": "..(cfg.Content or ""))
    end

    function Win:Toggle()
        mainFrame.Visible = not mainFrame.Visible
    end

    return Win
end

return ViloniX
