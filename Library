        local noteLbl = Instance.new("TextLabel")
        noteLbl.Size = UDim2.new(1, -40, 0, 16)
        noteLbl.Position = UDim2.fromOffset(20, 72)
        noteLbl.BackgroundTransparency = 1
        noteLbl.Text = "ℹ  " .. Note
        noteLbl.TextColor3 = Theme.TextDim
        noteLbl.Font = Enum.Font.Gotham
        noteLbl.TextSize = 11
        noteLbl.TextXAlignment = Enum.TextXAlignment.Left
        noteLbl.ZIndex = 102
        noteLbl.Parent = window
    end

    -- Input box
    local inputBg = Instance.new("Frame")
    inputBg.Size = UDim2.new(1, -40, 0, 40)
    inputBg.Position = UDim2.fromOffset(20, 100)
    inputBg.BackgroundColor3 = Theme.Surface
